  "projects": [
    {
      "id": 4,
      "projectName": "C64 WiFi Modem",
      "description": "A NodeMCU (ESP8266) based WiFi modem for the C64's user port This is a Wifi-Modem for the Commodore C64 Uperport, which is based on the ESP8266 (NodeMCU v3). It contains level shifters to translate between the NodeMCU 3.3V level and the User Port 5V level. This prevents stressing the User Port due to a level mismatch.",
      "url": "https://github.com/svenpetersen1965/C64-WiFi-Modem-User-Port",
      "photoUrl": "c64_modem.jpg"
    },
