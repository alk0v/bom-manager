# BOM Manager - Environment Configuration
PORT=3001
MEDIA_BASE_URL=/media

# Optional custom media directory path (defaults to <root>/media)
# MEDIA_DIR=./media

# Optional custom data directory path (defaults to <root>/data)
# DATA_DIR=./data

# =============================================================================
# OPTION 1: Autonomous SQLite (Default - Recommended for Self-Hosting)
# Zero external database required; uses embedded SQLite with WAL mode.
# =============================================================================
DB_TYPE=sqlite
# SQLITE_FILE=data/bommanager.sqlite

# =============================================================================
# OPTION 2: External MySQL / MariaDB Server
# =============================================================================
# DB_TYPE=mysql
# DB_HOST=192.168.1.100
# DB_PORT=3306
# DB_USER=bommanager_admin
# DB_PASSWORD=your_secure_password
# DB_NAME=retool_bommanager
