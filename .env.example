# =============================================================================
# BOM Manager - Environment Configuration (.env)
# Used for BOTH Docker Compose deployments and local Node.js runs.
# =============================================================================
PORT=3001
MEDIA_BASE_URL=/media

# Optional custom media directory path (defaults to <root>/media)
# MEDIA_DIR=./media

# Optional custom data directory path (defaults to <root>/data)
# DATA_DIR=./data

# =============================================================================
# OPTION 1: Autonomous SQLite (Default - Recommended for Self-Hosting)
# Zero external database required; uses embedded SQLite with WAL mode.
# =============================================================================
DB_TYPE=sqlite
# SQLITE_FILE=data/bommanager.sqlite

# Database initialization mode for SQLite:
# - true  : Pre-populate database with 3 sample hardware projects (C64 WiFi Modem, OpenFlops, Apple IIc to RGB),
#           50+ components, BOM mappings, purchase orders, and demo media assets (recommended for evaluation).
# - false : Clean setup with empty project catalog and standard electronics taxonomies only.
DEMO_DATA=true

# =============================================================================
# OPTION 2: External MySQL / MariaDB Server
# =============================================================================
# DB_TYPE=mysql
# DB_HOST=192.168.1.100
# DB_PORT=3306
# DB_USER=bommanager_admin
# DB_PASSWORD=your_secure_password
# DB_NAME=retool_bommanager
