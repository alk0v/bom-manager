{
  "name": "bommanager",
  "version": "0.3.2",
  "private": true,
  "description": "BOM Manager - Electronic Components and Project Bill of Materials Manager",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "seed:demo": "node server/src/utils/seedDemo.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
